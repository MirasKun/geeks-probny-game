{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geeks-frontend",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Classroom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Classroom"] }]
  // PIN пульта не в коде, а в секрете Cloudflare: npx wrangler secret put ADMIN_PIN
}
